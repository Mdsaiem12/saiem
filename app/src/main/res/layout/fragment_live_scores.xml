<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- League name + filter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_league_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Premier League"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Competition horizontal chips -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_competitions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Table header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="@color/bg_secondary"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView android:layout_width="30dp" android:layout_height="wrap_content"
            android:text="#" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Team" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <TextView android:layout_width="28dp" android:layout_height="wrap_content"
            android:text="P" android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center" />
        <TextView android:layout_width="28dp" android:layout_height="wrap_content"
            android:text="W" android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center" />
        <TextView android:layout_width="28dp" android:layout_height="wrap_content"
            android:text="D" android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center" />
        <TextView android:layout_width="28dp" android:layout_height="wrap_content"
            android:text="L" android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center" />
        <TextView android:layout_width="34dp" android:layout_height="wrap_content"
            android:text="GD" android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center" />
        <TextView android:layout_width="34dp" android:layout_height="wrap_content"
            android:text="Pts" android:textColor="@color/accent_green" android:textSize="12sp"
            android:textStyle="bold" android:gravity="center" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_standings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
